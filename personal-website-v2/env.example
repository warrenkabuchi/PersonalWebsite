# =========================================
# Warren Kabuchi Personal Website v2
# Environment Variables Configuration
# =========================================
# Copy this file to `.env.local` for development
# or configure in your hosting platform for production

# -----------------------------------------
# Firebase Client Configuration (Required)
# -----------------------------------------
# These are public keys used for client-side Firebase SDK
# Get these from: Firebase Console > Project Settings > Your Apps > Config
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# -----------------------------------------
# Firebase Admin Configuration (Required for server features)
# -----------------------------------------
# Used for server-side operations like creating posts
# Get these from: Firebase Console > Project Settings > Service Accounts > Generate New Private Key
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Note: The private key should include the full key with \n characters
# In production, you may need to replace literal \n with actual newlines
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# -----------------------------------------
# Email Configuration (Using Resend)
# -----------------------------------------
# Used for sending booking requests and contact form submissions
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your email address to receive form submissions
MY_EMAIL=hello@warrenkabuchi.com

# -----------------------------------------
# Site Configuration (Optional)
# -----------------------------------------
# Base URL for generating proper canonical links and sitemaps
# Default: https://warrenkabuchi.com
NEXT_PUBLIC_SITE_URL=https://warrenkabuchi.com

# -----------------------------------------
# Analytics (Optional)
# -----------------------------------------
# Vercel Analytics - automatically included when deployed on Vercel
# Google Analytics 4 - add your measurement ID if using GA4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# -----------------------------------------
# Development / Debug (Optional)
# -----------------------------------------
# Enable verbose logging for debugging Firebase issues
DEBUG_FIREBASE=false

# Skip certain features during development
SKIP_EMAIL_SENDING=false
